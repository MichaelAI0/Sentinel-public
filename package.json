{
  "name": "sentinel",
  "version": "1.0.0",
  "license": "SEE LICENSE IN LICENSE",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "bin": {
    "sentinel": "./packages/orchestrator/src/cli.ts"
  },
  "scripts": {
    "dev": "docker compose up",
    "dev:build": "docker compose up --build",
    "dev:web": "bun run --filter @sentinel/web dev",
    "build": "bun run --filter '*' build",
    "build:exec": "bash scripts/build-executable.sh",
    "build:exec:all": "bash scripts/build-executable.sh --all",
    "build:exec:linux": "bash scripts/build-executable.sh --target linux-x64",
    "build:exec:macos": "bash scripts/build-executable.sh --target darwin-x64",
    "build:exec:macos-arm": "bash scripts/build-executable.sh --target darwin-arm64",
    "build:exec:windows": "bash scripts/build-executable.sh --target windows-x64",
    "test": "bun test packages/shared packages/orchestrator packages/mcp-server",
    "test:web": "cd packages/web && bunx playwright test",
    "test:all": "bun test && bun run test:web",
    "test:coverage": "bun test packages/shared packages/orchestrator packages/mcp-server --coverage",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "typecheck": "bun run --filter '*' typecheck",
    "check": "biome check --write .",
    "clean": "rm -rf packages/*/dist dist",
    "sentinel": "bun run packages/orchestrator/src/cli.ts",
    "server": "bun run packages/orchestrator/src/index.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.11",
    "@types/bun": "^1.2.0",
    "@types/ghidra.js": "^1.0.0",
    "bun-types": "^1.3.6",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "zod": "^4.3.5"
  }
}
